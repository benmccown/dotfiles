{
  "uid": "pibrain-verbs",
  "title": "pi-brain verbs",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Per-verb (latest maintenance run)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "barchart",
      "title": "Token spend per verb (input + output)",
      "datasource": {
        "type": "prometheus",
        "uid": "pibrain-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "always",
        "legend": {
          "showLegend": false,
          "displayMode": "hidden"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pibrain-prometheus"
          },
          "expr": "sum by (verb) (last_over_time(pibrain_verb_input_tokens_total[6h]) + last_over_time(pibrain_verb_output_tokens_total[6h]))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{verb}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Duration per verb (seconds)",
      "datasource": {
        "type": "prometheus",
        "uid": "pibrain-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "always",
        "legend": {
          "showLegend": false,
          "displayMode": "hidden"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pibrain-prometheus"
          },
          "expr": "sum by (verb) (last_over_time(pibrain_verb_duration_ms_milliseconds_sum[6h])) / 1000",
          "format": "table",
          "instant": true,
          "legendFormat": "{{verb}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Output magnitude per verb (work done)",
      "datasource": {
        "type": "prometheus",
        "uid": "pibrain-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "always",
        "legend": {
          "showLegend": false,
          "displayMode": "hidden"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pibrain-prometheus"
          },
          "expr": "sum by (verb) (last_over_time(pibrain_verb_work_total[6h]))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{verb}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Cost vs output per verb",
      "datasource": {
        "type": "prometheus",
        "uid": "pibrain-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "tokens",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pibrain-prometheus"
          },
          "expr": "sum by (verb) (last_over_time(pibrain_verb_input_tokens_total[6h]) + last_over_time(pibrain_verb_output_tokens_total[6h]))",
          "format": "table",
          "instant": true,
          "refId": "tokens"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pibrain-prometheus"
          },
          "expr": "sum by (verb) (last_over_time(pibrain_verb_duration_ms_milliseconds_sum[6h])) / 1000",
          "format": "table",
          "instant": true,
          "refId": "duration_s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pibrain-prometheus"
          },
          "expr": "sum by (verb) (last_over_time(pibrain_verb_work_total[6h]))",
          "format": "table",
          "instant": true,
          "refId": "work"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "verb": "verb",
              "Value #tokens": "tokens",
              "Value #duration_s": "duration (s)",
              "Value #work": "work"
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Whole-pass rollup (all verbs summed)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Total tokens per maintenance run (in + out)",
      "datasource": {
        "type": "prometheus",
        "uid": "pibrain-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pibrain-prometheus"
          },
          "expr": "sum (last_over_time(pibrain_verb_input_tokens_total[6h]) + last_over_time(pibrain_verb_output_tokens_total[6h]))",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total pass duration (all verbs, seconds)",
      "datasource": {
        "type": "prometheus",
        "uid": "pibrain-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 20
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pibrain-prometheus"
          },
          "expr": "sum (last_over_time(pibrain_verb_duration_ms_milliseconds_sum[6h])) / 1000",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total input tokens per run",
      "datasource": {
        "type": "prometheus",
        "uid": "pibrain-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pibrain-prometheus"
          },
          "expr": "sum (last_over_time(pibrain_verb_input_tokens_total[6h]))",
          "instant": true,
          "refId": "A"
        }
      ]
    }
  ]
}