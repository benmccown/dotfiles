{
  "uid": "pibrain-verbs",
  "title": "pi-brain verbs",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "Maintenance run",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
        "query": {
          "query": "label_values(pibrain_verb_runs_total, run_id)",
          "refId": "run_id"
        },
        "sort": 4,
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Per-verb — selected run ($run_id)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "barchart",
      "title": "Token spend per verb (input + output) — $run_id",
      "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 1 },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": { "showLegend": false, "displayMode": "hidden" },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
          "expr": "sum by (verb) (last_over_time(pibrain_verb_input_tokens_total{run_id=\"$run_id\"}[24h]) + last_over_time(pibrain_verb_output_tokens_total{run_id=\"$run_id\"}[24h]))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{verb}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Duration per verb (seconds) — $run_id",
      "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 1 },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": { "showLegend": false, "displayMode": "hidden" },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
          "expr": "sum by (verb) (last_over_time(pibrain_verb_duration_ms_milliseconds_sum{run_id=\"$run_id\"}[24h])) / 1000",
          "format": "table",
          "instant": true,
          "legendFormat": "{{verb}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Output magnitude per verb (work done) — $run_id",
      "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 10 },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": { "showLegend": false, "displayMode": "hidden" },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
          "expr": "sum by (verb) (last_over_time(pibrain_verb_work_total{run_id=\"$run_id\"}[24h]))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{verb}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Cost vs output per verb — $run_id",
      "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 10 },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "tokens", "desc": true }]
      },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
          "expr": "sum by (verb) (last_over_time(pibrain_verb_input_tokens_total{run_id=\"$run_id\"}[24h]) + last_over_time(pibrain_verb_output_tokens_total{run_id=\"$run_id\"}[24h]))",
          "format": "table",
          "instant": true,
          "refId": "tokens"
        },
        {
          "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
          "expr": "sum by (verb) (last_over_time(pibrain_verb_duration_ms_milliseconds_sum{run_id=\"$run_id\"}[24h])) / 1000",
          "format": "table",
          "instant": true,
          "refId": "duration_s"
        },
        {
          "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
          "expr": "sum by (verb) (last_over_time(pibrain_verb_work_total{run_id=\"$run_id\"}[24h]))",
          "format": "table",
          "instant": true,
          "refId": "work"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "verb": "verb",
              "Value #tokens": "tokens",
              "Value #duration_s": "duration (s)",
              "Value #work": "work"
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Selected-run totals ($run_id)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Total tokens this run (in + out)",
      "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 20 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
          "expr": "sum (last_over_time(pibrain_verb_input_tokens_total{run_id=\"$run_id\"}[24h]) + last_over_time(pibrain_verb_output_tokens_total{run_id=\"$run_id\"}[24h]))",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Pass wall-clock duration this run",
      "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 20 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": { "unit": "ms", "color": { "mode": "thresholds" } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
          "expr": "sum (last_over_time(pibrain_pass_duration_ms_milliseconds_sum{run_id=\"$run_id\"}[24h]))",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total input tokens this run",
      "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 20 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
          "expr": "sum (last_over_time(pibrain_verb_input_tokens_total{run_id=\"$run_id\"}[24h]))",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Run-over-run trend (all runs)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Total tokens per run (compare runs over time)",
      "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 27 },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1, "pointSize": 6 },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
          "expr": "sum by (run_id) (pibrain_verb_input_tokens_total + pibrain_verb_output_tokens_total)",
          "instant": false,
          "legendFormat": "{{run_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "clean-link tokens per run (did tuning help?)",
      "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 27 },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1, "pointSize": 6 },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pibrain-prometheus" },
          "expr": "sum by (run_id) (pibrain_verb_input_tokens_total{verb=\"clean-link\"} + pibrain_verb_output_tokens_total{verb=\"clean-link\"})",
          "instant": false,
          "legendFormat": "{{run_id}}",
          "refId": "A"
        }
      ]
    }
  ]
}
