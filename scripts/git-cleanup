#!/usr/bin/env bash
set -euo pipefail

PROTECTED_BRANCHES=("main")
LOG_DIR="$HOME/.scripts/logs"
LOG_FILE="$LOG_DIR/git-cleanup.log"

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Interactively prune local git branches.

Displays numbered local branches (excluding protected branches and the
current branch), then asks which ones to KEEP. Everything else is deleted
after a final confirmation.

Options:
  -h, --help    Show this help message and exit
  -d, --dry-run Show what would be deleted without actually deleting
  -a, --all     Delete all listed branches (skip the keep prompt)
  -u, --undo    Restore previously deleted branches from the log

Protected branches (never offered for deletion):
  ${PROTECTED_BRANCHES[*]}

Workflow:
  1. Branches are listed with numbers
  2. Enter numbers of branches to KEEP (comma-separated), or press Enter to keep none
  3. Review the deletion list
  4. Confirm to delete

Examples:
  $(basename "$0")          # Interactive pruning
  $(basename "$0") -d       # Dry run — preview without deleting
  $(basename "$0") -a       # Delete all non-protected branches
  $(basename "$0") -u       # Restore previously deleted branches
EOF
}

parse_keep_input() {
    local input="$1"
    local max="$2"
    local -n _indices=$3

    IFS=',' read -ra tokens <<< "$input"
    for token in "${tokens[@]}"; do
        token=$(echo "$token" | tr -d '[:space:]')

        if [[ "$token" =~ ^[0-9]+-[0-9]+$ ]]; then
            local range_start="${token%-*}"
            local range_end="${token#*-}"
            for (( n=range_start; n<=range_end; n++ )); do
                if (( n >= 1 && n <= max )); then
                    _indices+=($((n - 1)))
                else
                    echo "Warning: $n is out of range, ignoring." >&2
                fi
            done
        elif [[ "$token" =~ ^[0-9]+$ ]]; then
            if (( token >= 1 && token <= max )); then
                _indices+=($((token - 1)))
            else
                echo "Warning: $token is out of range, ignoring." >&2
            fi
        else
            echo "Warning: '$token' is not a valid number, ignoring." >&2
        fi
    done
}

ensure_log_dir() {
    [[ -d "$LOG_DIR" ]] || mkdir -p "$LOG_DIR"
}

log_deletion() {
    local branch="$1" hash="$2" repo="$3" timestamp
    timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
    echo "${timestamp}|${repo}|${branch}|${hash}" >> "$LOG_FILE"
}

do_undo() {
    if [[ ! -f "$LOG_FILE" ]] || [[ ! -s "$LOG_FILE" ]]; then
        echo "No deletion history found."
        exit 0
    fi

    mapfile -t all_lines < "$LOG_FILE"
    local total=${#all_lines[@]}
    local show=$(( total < 50 ? total : 50 ))
    local offset=$(( total - show ))

    local recent=()
    for (( i=offset; i<total; i++ )); do
        recent+=("${all_lines[$i]}")
    done

    echo "Recently deleted branches (newest last):"
    echo ""
    for i in "${!recent[@]}"; do
        local line="${recent[$i]}"
        local ts branch repo hash
        IFS='|' read -r ts repo branch hash <<< "$line"
        printf "  %3d) %-50s %s  %s\n" $((i + 1)) "$branch" "$ts" "$repo"
    done
    echo ""

    read -rp "Branches to RESTORE (comma-separated numbers, or Enter to cancel): " input </dev/tty

    if [[ -z "$input" ]]; then
        echo "Cancelled."
        exit 0
    fi

    local restore_indices=()
    parse_keep_input "$input" "${#recent[@]}" restore_indices

    if [[ ${#restore_indices[@]} -eq 0 ]]; then
        echo "No valid selections."
        exit 0
    fi

    echo ""
    echo "Restoring:"
    for idx in "${restore_indices[@]}"; do
        local line="${recent[$idx]}"
        local ts branch repo hash
        IFS='|' read -r ts repo branch hash <<< "$line"
        echo "  + $branch ($hash)"
    done
    echo ""

    read -rp "Proceed? [y/N] " confirm </dev/tty
    case "$confirm" in
        [yY]|[yY][eE][sS]) ;;
        *)
            echo "Aborted."
            exit 0
            ;;
    esac

    echo ""
    local restored_global_indices=()
    for idx in "${restore_indices[@]}"; do
        local line="${recent[$idx]}"
        local ts branch repo hash
        IFS='|' read -r ts repo branch hash <<< "$line"
        if git branch "$branch" "$hash" 2>/dev/null; then
            echo "Restored: $branch"
            restored_global_indices+=($((offset + idx)))
        else
            echo "Failed to restore '$branch' — commit $hash may have been garbage collected." >&2
        fi
    done

    if [[ ${#restored_global_indices[@]} -gt 0 ]]; then
        local tmp
        tmp=$(mktemp)
        for (( i=0; i<total; i++ )); do
            local skip=0
            for gi in "${restored_global_indices[@]}"; do
                if [[ "$i" -eq "$gi" ]]; then
                    skip=1
                    break
                fi
            done
            if [[ $skip -eq 0 ]]; then
                echo "${all_lines[$i]}"
            fi
        done > "$tmp"
        mv "$tmp" "$LOG_FILE"
    fi

    echo ""
    echo "Done."
    exit 0
}

DRY_RUN=0
DELETE_ALL=0
UNDO=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -d|--dry-run)
            DRY_RUN=1
            shift
            ;;
        -a|--all)
            DELETE_ALL=1
            shift
            ;;
        -u|--undo)
            UNDO=1
            shift
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

if [[ $UNDO -eq 1 ]]; then
    do_undo
fi

if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    echo "Error: not inside a git repository." >&2
    exit 1
fi

is_protected() {
    local branch="$1"
    for protected in "${PROTECTED_BRANCHES[@]}"; do
        [[ "$branch" == "$protected" ]] && return 0
    done
    return 1
}

current_branch=$(git branch --show-current)
repo_root=$(git rev-parse --show-toplevel)

mapfile -t all_branches < <(git branch --format='%(refname:short)' | sort)

branches=()
for b in "${all_branches[@]}"; do
    is_protected "$b" && continue
    [[ "$b" == "$current_branch" ]] && continue
    branches+=("$b")
done

if [[ ${#branches[@]} -eq 0 ]]; then
    echo "No deletable local branches found (protected and current branch excluded)."
    exit 0
fi

echo "Local branches (excluding: ${PROTECTED_BRANCHES[*]}, $current_branch):"
echo ""
for i in "${!branches[@]}"; do
    printf "  %3d) %s\n" $((i + 1)) "${branches[$i]}"
done
echo ""

keep_indices=()

if [[ $DELETE_ALL -eq 0 ]]; then
    read -rp "Branches to KEEP (comma-separated numbers, or Enter for none): " input </dev/tty

    if [[ -n "$input" ]]; then
        parse_keep_input "$input" "${#branches[@]}" keep_indices
    fi
fi

to_delete=()
to_keep=()
for i in "${!branches[@]}"; do
    is_kept=0
    for k in "${keep_indices[@]+"${keep_indices[@]}"}"; do
        if [[ "$i" -eq "$k" ]]; then
            is_kept=1
            break
        fi
    done
    if [[ $is_kept -eq 1 ]]; then
        to_keep+=("${branches[$i]}")
    else
        to_delete+=("${branches[$i]}")
    fi
done

echo ""

if [[ ${#to_delete[@]} -eq 0 ]]; then
    echo "No branches selected for deletion."
    exit 0
fi

if [[ ${#to_keep[@]} -gt 0 ]]; then
    echo "Keeping:"
    for branch in "${to_keep[@]}"; do
        echo "  + $branch"
    done
    echo ""
fi

echo "Deleting:"
for branch in "${to_delete[@]}"; do
    echo "  - $branch"
done
echo ""

read -rp "Proceed with deletion of ${#to_delete[@]} branch(es)? [y/N] " confirm </dev/tty
case "$confirm" in
    [yY]|[yY][eE][sS])
        ;;
    *)
        echo "Aborted."
        exit 0
        ;;
esac

ensure_log_dir

echo ""
for branch in "${to_delete[@]}"; do
    if [[ $DRY_RUN -eq 1 ]]; then
        echo "[dry-run] Would delete: $branch (git branch -D $branch)"
    else
        hash=$(git rev-parse "$branch" 2>/dev/null || true)
        if git branch -D "$branch" 2>/dev/null; then
            echo "Deleted: $branch"
            if [[ -n "$hash" ]]; then
                log_deletion "$branch" "$hash" "$repo_root"
            fi
        else
            echo "Failed to delete '$branch'." >&2
        fi
    fi
done

echo ""
echo "Done."
