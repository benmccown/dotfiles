#!/usr/bin/env bash
# pi-slack-dev — start ONE pi session with the Slack bridge loaded, INSIDE the
# devcontainer. This is the opt-in Slack bot: run it manually in a single cmux
# workspace. Every other `pi-dev` session stays clean (no bridge, no Slack).
#
# It runs inside the same devcontainer as pi-dev, so it inherits pi-brain, your
# memory vault, session-recall, MCP, and the local nemo provider automatically.
#
# Requires (from ~/.config/secrets.env, present in the container via .zshenv):
#   PI_SLACK_BOT_TOKEN  PI_SLACK_APP_TOKEN  PI_SLACK_OWNER_ID
#
# Usage:
#   pi-slack-dev            # start the Slack bot session
#   pi-slack-dev --shell    # debug: shell in the container instead
set -euo pipefail

NAME="${PI_DEV_CONTAINER:-pi-agent}"
BRIDGE=/opt/slack-bridge/node_modules/pi-messenger-bridge/dist/index.js

# --- when ALREADY inside the container, seed config + run pi directly ---
if [ -f /.dockerenv ] || [ "${PI_DEV_INSIDE:-}" = "1" ]; then
  : "${PI_SLACK_BOT_TOKEN:?set PI_SLACK_BOT_TOKEN (source ~/.config/secrets.env)}"
  : "${PI_SLACK_APP_TOKEN:?set PI_SLACK_APP_TOKEN}"
  : "${PI_SLACK_OWNER_ID:?set PI_SLACK_OWNER_ID}"
  [ -f "$BRIDGE" ] || { echo "pi-slack-dev: bridge not found at $BRIDGE (rebuild the image)" >&2; exit 1; }

  # Seed the single-user allowlist (fail closed via the guards above).
  mkdir -p "$HOME/.pi"
  cat > "$HOME/.pi/msg-bridge.json" <<JSON
{
  "auth": {
    "trustedUsers": ["slack:${PI_SLACK_OWNER_ID}"],
    "adminUserId": "slack:${PI_SLACK_OWNER_ID}"
  },
  "autoConnect": true,
  "showWidget": true
}
JSON
  chmod 600 "$HOME/.pi/msg-bridge.json"

  case "${1:-}" in
    --shell) shift; exec zsh -l ;;
    *) exec pi -e "$BRIDGE" "$@" ;;   # bridge loaded for THIS session only
  esac
fi

# --- on the host: dispatch into the running devcontainer ---
command -v docker >/dev/null || { echo "pi-slack-dev: docker not found" >&2; exit 1; }
if ! docker ps --format '{{.Names}}' | grep -qx "$NAME"; then
  echo "pi-slack-dev: container '$NAME' not running. Start it with:" >&2
  echo "  ~/Code/dotfiles/pi-devcontainer/install.sh" >&2
  exit 1
fi

# Forward PI_* env; run with a TTY so pi's session stays alive.
env_args=()
for v in $(env | grep -oE '^PI_[A-Z0-9_]+' || true); do env_args+=(-e "$v"); done
tty_flag=(-i); [ -t 0 ] && [ -t 1 ] && tty_flag=(-it)

exec docker exec "${tty_flag[@]}" -u dev -w "$PWD" "${env_args[@]}" \
  -e PI_DEV_INSIDE=1 "$NAME" zsh -lc 'exec pi-slack-dev "$@"' _ "$@"
