# Homebrew CLI dependencies for dotfiles workflows (macOS host).
# Reconcile:  brew bundle --file=Brewfile        (idempotent; installs what's missing)
# Check:      brew bundle check --file=Brewfile
#
# Scope: host CLIs the dotfiles scripts/skills depend on that aren't part of a
# base dev setup. Keep this tight — add a tool only when a workflow needs it.

# chrome-tab-triage skill: read/close Chrome tabs from the CLI.
brew "chrome-cli"
