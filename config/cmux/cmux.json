{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // This file uses JSON with comments (JSONC).
  // ACTIVE blocks (commands/ui/actions + our shortcut overrides) are UNCOMMENTED below.
  // The commented sections are the full DEFAULT reference (cmux 0.64.x): uncomment a key
  // to make it file-managed; remove it to fall back to the built-in default. Reload with
  // Cmd+Shift+, (or `cmux reload-config`).

  // ===== ACTIVE: custom workspace commands, + menu, tab-bar buttons =====
  "commands": [
    {
      "name": "pi-brain",
      "description": "Open ~/Code/pi-brain: pi session + a bare shell tab",
      "keywords": [
        "pi-brain",
        "brain",
        "pi"
      ],
      "workspace": {
        "name": "pi-brain",
        "cwd": "~/Code/pi-brain",
        "restart": "ignore",
        "layout": {
          "pane": {
            "surfaces": [
              {
                "type": "terminal",
                "name": "pi",
                "command": "pi",
                "focus": true
              },
              {
                "type": "terminal",
                "name": "shell"
              }
            ]
          }
        }
      }
    },
    {
      "name": "nemo-platform",
      "description": "Open ~/Code/nemo-platform: pi session + a bare shell tab",
      "keywords": [
        "nemo",
        "nmp",
        "platform",
        "pi"
      ],
      "workspace": {
        "name": "nemo-platform",
        "cwd": "~/Code/nemo-platform",
        "restart": "ignore",
        "layout": {
          "pane": {
            "surfaces": [
              {
                "type": "terminal",
                "name": "pi",
                "command": "pi",
                "focus": true
              },
              {
                "type": "terminal",
                "name": "shell"
              }
            ]
          }
        }
      }
    },
    {
      "name": "general",
      "description": "Open ~/Code: pi session + a bare shell tab",
      "keywords": [
        "general",
        "code",
        "scratch",
        "pi"
      ],
      "workspace": {
        "name": "general",
        "cwd": "~/Code",
        "restart": "new",
        "layout": {
          "pane": {
            "surfaces": [
              {
                "type": "terminal",
                "name": "pi",
                "command": "pi",
                "focus": true
              },
              {
                "type": "terminal",
                "name": "shell"
              }
            ]
          }
        }
      }
    },
    {
      "name": "Worktree Agent",
      "description": "Pick a ~/Code repo + branch, spin up a git worktree, and open a fresh pi session in it",
      "keywords": [
        "worktree",
        "agent",
        "branch",
        "parallel",
        "spawn"
      ],
      "workspace": {
        "name": "worktree-agent",
        "cwd": "~/Code",
        "restart": "new",
        "layout": {
          "pane": {
            "surfaces": [
              {
                "type": "terminal",
                "name": "worktree",
                "focus": true,
                "command": "~/Code/pi-brain/brain/memory/skills/worktree-agent/scripts/pick-worktree.sh"
              }
            ]
          }
        }
      }
    },
    {
      "name": "remote nemo-platform",
      "description": "Open ~/Code/nemo-platform on the Omnistation box (cmux remote-SSH workspace)",
      "keywords": [
        "remote",
        "omnistation",
        "nemo",
        "nmp",
        "box",
        "ssh",
        "pi"
      ],
      "command": "cmux ssh bmccown@omni-lsn-7bde6.ext-nv-prd-apps.teleport.sh --name 'remote nemo-platform' --command 'cd ~/Code/nemo-platform'"
    },
    {
      "name": "Open in Viewer",
      "description": "Render the current directory's README.md in a live-reloading cmux markdown panel",
      "keywords": [
        "markdown",
        "viewer",
        "readme",
        "preview",
        "render"
      ],
      "command": "cmux markdown open README.md --direction right --focus false"
    }
  ],

  "ui": {
    "newWorkspace": {
      "contextMenu": [
        {
          "action": "pi-brain",
          "title": "pi-brain"
        },
        {
          "action": "nemo-platform",
          "title": "nemo-platform"
        },
        {
          "action": "remote-nemo-platform",
          "title": "remote nemo-platform (Omnistation)"
        },
        {
          "action": "general",
          "title": "general (~/Code)"
        },
        {
          "type": "separator"
        },
        {
          "action": "worktree-agent",
          "title": "Worktree Agent\u2026"
        },
        {
          "type": "separator"
        },
        {
          "action": "cmux.newTerminal",
          "title": "New Terminal"
        },
        {
          "action": "cmux.newBrowser",
          "title": "New Browser"
        }
      ]
    },
    "surfaceTabBar": {
      "buttons": [
        "cmux.newTerminal",
        "cmux.newBrowser",
        "cmux.splitRight",
        "cmux.splitDown",
        "pi-here",
        "remote-nemo-platform"
      ]
    }
  },

  "actions": {
    "pi-brain": {
      "type": "workspaceCommand",
      "title": "pi-brain",
      "commandName": "pi-brain"
    },
    "nemo-platform": {
      "type": "workspaceCommand",
      "title": "nemo-platform",
      "commandName": "nemo-platform"
    },
    "remote-nemo-platform": {
      "type": "command",
      "title": "remote nemo-platform (Omnistation)",
      "subtitle": "cmux ssh into the box + cd ~/Code/nemo-platform",
      "command": "cmux ssh bmccown@omni-lsn-7bde6.ext-nv-prd-apps.teleport.sh --name 'remote nemo-platform' --command 'cd ~/Code/nemo-platform'",
      "target": "newTabInCurrentPane"
    },
    "general": {
      "type": "workspaceCommand",
      "title": "general (~/Code)",
      "commandName": "general"
    },
    "worktree-agent": {
      "type": "workspaceCommand",
      "title": "Worktree Agent\u2026",
      "commandName": "Worktree Agent"
    },
    "pi-here": {
      "type": "command",
      "title": "pi",
      "subtitle": "Start a pi session in a new tab here",
      "command": "pi",
      "target": "newTabInCurrentPane",
      "shortcut": "cmd+shift+i",
      "icon": {
        "type": "emoji",
        "value": "\u03c0",
        "scale": 1.0
      }
    }
  },

  // ===== ACTIVE: keyboard shortcut overrides (ported from Ben's Cursor keybindings) =====
  //   cmd+ctrl+h / cmd+ctrl+l : prev/next WORKSPACE (sidebar tab)
  //   cmd+ctrl+,             : rename the WORKSPACE (sidebar tab) [renameWorkspace]
  //   cmd+ctrl+.             : rename the SURFACE/tab (in-pane tab) [renameTab]
  //                            (displaces default toggleFocusedWorkspaceGroupCollapsed)
  //   cmd+ctrl+n             : new WORKSPACE [newTab] (frees default cmd+n)
  //   cmd+opt+p              : command palette (frees default cmd+shift+p)
  // Only these keys are overridden; every other binding uses the cmux default
  // shown (commented) in the reference block that follows.
  "shortcuts": {
    "bindings": {
      "prevSidebarTab": "cmd+ctrl+h",
      "nextSidebarTab": "cmd+ctrl+l",
      "renameWorkspace": "cmd+ctrl+,",
      "renameTab": "cmd+ctrl+.",
      "commandPalette": "cmd+opt+p",
      "newTab": "cmd+ctrl+n"
    }
  },

